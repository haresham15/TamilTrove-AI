# Copy to .env for Docker Compose development. Never use these development
# values in a public deployment.
POSTGRES_DB=tamiltrove
POSTGRES_USER=tamiltrove
POSTGRES_PASSWORD=tamiltrove-local-only
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

TAMILTROVE_ENV=development
TAMILTROVE_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_SECONDS=3600
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Reliable local mode uses the deterministic multilingual character index. Set
# both values below to a benchmarked multilingual transformer only when the
# deployment may download the model and regenerate compatible embeddings.
TAMILTROVE_ENABLE_TRANSFORMER=false
TAMILTROVE_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
TAMILTROVE_MODEL_VERSION=1
TAMILTROVE_RANKING_VERSION=v2-local-hybrid-1

# Optional observability profile
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
# Set to http://otel-collector:4318 only with the observability profile.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional cache profile. V2 does not require Redis for correctness.
REDIS_PORT=6379
